		     scaled-vox physics failure encountered by earlier test versions. -->
		<vox pos="0.55 0.1 0" tags="cannonball tetherball unbreakable" density="12" strength="100" file="MOD/vox/cannonball.vox"/>
		<vox pos="-0.55 0.1 0" tags="cannonball tetherball unbreakable" density="12" strength="100" file="MOD/vox/cannonball.vox"/>
		<vox pos="0 0.65 0" tags="cannonball tetherball unbreakable" density="12" strength="100" file="MOD/vox/cannonball.vox"/>
		<vox pos="0 -0.45 0" tags="cannonball tetherball unbreakable" density="12" strength="100" file="MOD/vox/cannonball.vox"/>
		<vox pos="0 0.1 0.55" tags="cannonball tetherball unbreakable" density="12" strength="100" file="MOD/vox/cannonball.vox"/>
		<vox pos="0 0.1 -0.55" tags="cannonball tetherball unbreakable" density="12" strength="100" file="MOD/vox/cannonball.vox"/>
	</body>
</group>
