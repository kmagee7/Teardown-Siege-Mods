<group name="tethered_physics_cannonball_prefab">
	<body name="tether_ball" tags="awake physicsball tetherball" dynamic="true">
		<vox
			name="tether_ball_shape"
			tags="cannonball physicsball tetherball unbreakable"
			pos="0 0.1 0"
			density="75"
			strength="100"
			file="MOD/vox/cannonball.vox"/>
